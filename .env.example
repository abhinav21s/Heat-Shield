# FortyGuard API Configuration
# Sign up at https://fortyguard.com to obtain your API credentials.
# If left blank, HeatShield automatically runs on FortyGuard's simulated real-time thermal engine.
FORTYGUARD_API_KEY=
FORTYGUARD_API_URL=https://api.fortyguard.com

# TomTom Maps API Configuration
# Sign up at https://developer.tomtom.com/ to get your TomTom Map display key.
NEXT_PUBLIC_TOMTOM_API_KEY=
TOMTOM_API_KEY=
